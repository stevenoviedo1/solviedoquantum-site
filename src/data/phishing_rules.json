    "impersonation_score": 36,
    "typosquat_score": 34
  },

  "trusted_domains": [
    "google.com", "gmail.com", "microsoft.com", "live.com", "outlook.com",
    "apple.com", "icloud.com", "amazon.com", "paypal.com", "github.com",
    "linkedin.com", "facebook.com", "twitter.com", "x.com", "instagram.com",
    "wikipedia.org", "gov", "edu", "solviedoquantum.com", "quantumstockgame.com"
  ],

  "url_path_red_flags": [
    "login", "signin", "sign-in", "verify", "secure", "account", "update",
    "confirm", "password", "wallet", "session", "auth", "oauth", "billing",
    "unlock", "recover", "support-ticket", "webscr"
  ],

  "scoring": {
    "max_score": 100,
    "thresholds": {
      "CRITICAL": 70,
      "HIGH": 50,
      "MEDIUM": 30,
      "LOW": 0
    },
    "sensitivity": {
      "strict": {"score_multiplier": 1.15, "threshold_offset": -8},
      "balanced": {"score_multiplier": 1.0, "threshold_offset": 0},
      "quiet": {"score_multiplier": 0.85, "threshold_offset": 10}
    }
  },

  "playbooks": {
    "CRITICAL": "1. Do not click any links or open attachments.\n2. Disconnect if you already clicked — change passwords from a known-good device.\n3. Report as phishing in your email client.\n4. Enable 2FA on affected accounts.\n5. Check bank/crypto activity for unauthorized actions.",
    "HIGH": "1. Do not interact with links or forms in this message.\n2. Delete or quarantine the email.\n3. Report phishing to your provider.\n4. Visit official sites only by typing the URL yourself.\n5. Monitor account notifications for the next 48 hours.",
    "MEDIUM": "1. Treat links with caution — verify the real domain hover/preview.\n2. Prefer navigating to the service via bookmark or typed URL.\n3. Do not enter credentials from this message.\n4. Report if it keeps arriving.",
    "LOW": "1. No strong automated red flags — still verify unexpected requests.\n2. Never share passwords, MFA codes, or seed phrases.\n3. When unsure, contact the organization via a known channel."
  }
}
