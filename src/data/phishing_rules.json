      },
      {
        "name": "Banking",
        "keywords": ["chase", "bank of america", "wells fargo", "citibank", "capital one"],
        "legit_domains": ["chase.com", "bankofamerica.com", "wellsfargo.com", "citi.com", "capitalone.com"]
